# Base URL for the Smarkets HTTP API (server-side only, never exposed to the client).
SMARKETS_API_BASE_URL=https://api.smarkets.com

# Credentials for manual login testing against POST /v3/sessions/.
# Rate-limited to 5 requests / 300s — do not loop against this endpoint.
SMARKETS_USERNAME=
SMARKETS_PASSWORD=
